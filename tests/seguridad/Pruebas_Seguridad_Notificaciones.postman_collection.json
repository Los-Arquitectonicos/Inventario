		{
			"name": "4. Pruebas de Autorización por Rol",
			"item": [
				{
					"name": "❌ Operario intenta listar todos los usuarios",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 403 Forbidden\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"",
									"pm.test(\"Mensaje indica falta de permisos\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.detail).to.include('admin');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{OPERARIO_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/notifications/users",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"notifications",
								"users"
							]
						},
						"description": "Un operario no debe poder listar todos los usuarios (solo admin)"
					},
					"response": []
				},
				{
					"name": "✅ Admin lista todos los usuarios",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna array de usuarios\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"    pm.expect(jsonData.length).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{ADMIN_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/notifications/users",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"notifications",
								"users"
							]
						},
						"description": "Admin debe poder listar todos los usuarios"
					},
					"response": []
				},
				{
					"name": "❌ Operario intenta ver detalles de otro usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 403 Forbidden\", function () {",
									"    pm.response.to.have.status(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{OPERARIO_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/notifications/users/empacador1",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"notifications",
								"users",
								"empacador1"
							]
						},
						"description": "Un operario no debe poder ver detalles de otros usuarios"
					},
					"response": []
				},
				{
					"name": "✅ Admin ve detalles de cualquier usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna información del usuario\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('username');",
									"    pm.expect(jsonData.username).to.equal('operario1');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{ADMIN_TOKEN}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/notifications/users/operario1",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"notifications",
								"users",
								"operario1"
							]
						},
						"description": "Admin debe poder ver detalles de cualquier usuario"
					},
					"response": []
				}
			],
			"description": "Pruebas de control de acceso basado en roles (RBAC)"
		},
