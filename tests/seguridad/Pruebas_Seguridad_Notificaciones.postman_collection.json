		{
			"name": "6. Pruebas de Inyección y XSS",
			"item": [
				{
					"name": "❌ SQL Injection en username",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"No debe permitir SQL Injection\", function () {",
									"    pm.expect([401, 404]).to.include(pm.response.code);",
									"});",
									"",
									"pm.test(\"No debe retornar datos sensibles\", function () {",
									"    var responseText = pm.response.text();",
									"    pm.expect(responseText).to.not.include('password');",
									"    pm.expect(responseText).to.not.include('hashed_password');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin' OR '1'='1\",\n    \"password\": \"cualquiera\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/notifications/auth/login",
							"host": [
