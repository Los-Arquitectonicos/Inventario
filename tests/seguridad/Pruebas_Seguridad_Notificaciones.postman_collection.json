							"path": [
								"notifications",
								"send"
							]
						},
						"description": "Intenta enviar una notificación sin autenticación. Debe retornar 401."
					},
					"response": []
				}
			],
			"description": "Pruebas de acceso a endpoints protegidos sin proporcionar token de autenticación"
		},
