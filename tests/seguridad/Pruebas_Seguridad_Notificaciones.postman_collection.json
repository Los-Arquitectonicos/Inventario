				{
					"name": "❌ Enviar notificación sin token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Intento de envío sin autenticación\",\n    \"recipient_username\": \"operario1\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/notifications/send",
							"host": [
								"{{BASE_URL}}"
