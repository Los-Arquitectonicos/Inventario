{
	"info": {
		"_postman_id": "a8c5e9f2-3d4a-4e8b-9c1d-5f6e7a8b9c0d",
		"name": "Pruebas de Seguridad - Microservicio Notificaciones",
		"description": "Suite de pruebas de seguridad para verificar autenticación y autorización en el microservicio de notificaciones a través de Kong API Gateway.\n\nPruebas incluidas:\n- Acceso sin autenticación (debe fallar)\n- Acceso con token inválido (debe fallar)\n- Acceso con token expirado (debe fallar)\n- Acceso con token válido pero rol incorrecto\n- Acceso con token válido y rol correcto\n- SQL Injection en parámetros\n- XSS en mensajes\n- Intento de acceso a notificaciones de otros usuarios",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Pruebas Sin Autenticación",
			"item": [
				{
					"name": "❌ Listar notificaciones sin token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Debe retornar 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Debe incluir mensaje de error de autenticación\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('detail');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/notifications/inbox",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"notifications",
								"inbox"
							]
						},
						"description": "Intenta acceder al inbox sin proporcionar token de autenticación. Debe retornar 401."
					},
					"response": []
				},
