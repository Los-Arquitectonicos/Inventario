{
  "info": {
    "name": "ProvesiWMS - Crear 50 Productos",
    "description": "Colección para crear 50 productos distintos de manera automatizada",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Crear Producto Aleatorio",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Arrays de datos para generar productos aleatorios",
              "",
              "const marcas = [",
              "    'Apple', 'Samsung', 'Sony', 'LG', 'Huawei', 'Xiaomi', 'OnePlus',",
              "    'Google', 'Motorola', 'Nokia', 'Oppo', 'Vivo', 'Realme', 'Honor',",
              "    'HP', 'Dell', 'Lenovo', 'Asus', 'Acer', 'MSI', 'Razer',",
              "    'Microsoft', 'Canon', 'Nikon', 'GoPro', 'DJI', 'Bose', 'JBL'",
              "];",
              "",
              "const categorias = [",
              "    { tipo: 'Smartphone', adjectives: ['Pro', 'Ultra', 'Max', 'Plus', 'Lite', 'Mini', 'Standard'] },",
              "    { tipo: 'Laptop', adjectives: ['Pro', 'Gaming', 'Business', 'Ultra', 'Slim', 'Book', 'Air'] },",
              "    { tipo: 'Tablet', adjectives: ['Pro', 'Air', 'Mini', 'Plus', 'Standard', 'Kids', 'Gaming'] },",
              "    { tipo: 'Smartwatch', adjectives: ['Sport', 'Classic', 'Pro', 'Fitness', 'Ultra', 'SE', 'GT'] },",
              "    { tipo: 'Auriculares', adjectives: ['Pro', 'Sport', 'Studio', 'Wireless', 'Gaming', 'Noise Cancelling'] },",
              "    { tipo: 'Cámara', adjectives: ['DSLR', 'Mirrorless', 'Action', 'Instant', 'Professional', 'Compact'] },",
              "    { tipo: 'Monitor', adjectives: ['Gaming', '4K', 'UltraWide', 'Curved', 'Professional', 'Portable'] },",
              "    { tipo: 'Teclado', adjectives: ['Mechanical', 'Gaming', 'Wireless', 'Compact', 'Ergonomic', 'RGB'] },",
              "    { tipo: 'Mouse', adjectives: ['Gaming', 'Wireless', 'Ergonomic', 'Vertical', 'Trackball', 'Precision'] },",
              "    { tipo: 'Parlante', adjectives: ['Bluetooth', 'Smart', 'Portable', 'Waterproof', 'Studio', 'Party'] }",
              "];",
              "",
              "const colores = [",
              "    'Negro', 'Blanco', 'Gris', 'Plata', 'Dorado', 'Azul', 'Rojo',",
              "    'Verde', 'Rosa', 'Morado', 'Naranja', 'Amarillo', 'Bronce',",
              "    'Negro Mate', 'Azul Marino', 'Verde Militar', 'Rosa Gold',",
              "    'Gris Espacial', 'Titanio', 'Champagne', 'Coral', 'Lavanda'",
              "];",
              "",
              "const tallas = {",
              "    'Smartphone': ['5.0\"', '5.5\"', '6.0\"', '6.1\"', '6.2\"', '6.3\"', '6.4\"', '6.5\"', '6.7\"', '6.8\"'],",
              "    'Laptop': ['11\"', '12\"', '13\"', '14\"', '15\"', '15.6\"', '16\"', '17\"', '17.3\"'],",
              "    'Tablet': ['7\"', '8\"', '9\"', '10\"', '10.1\"', '10.5\"', '11\"', '12\"', '12.9\"'],",
              "    'Smartwatch': ['38mm', '40mm', '41mm', '42mm', '44mm', '45mm', '46mm', '49mm'],",
              "    'Monitor': ['21\"', '22\"', '24\"', '25\"', '27\"', '28\"', '29\"', '32\"', '34\"', '35\"'],",
              "    'Auriculares': ['Over-ear', 'On-ear', 'In-ear', 'True Wireless', 'Neckband'],",
              "    'Cámara': ['Compact', 'APS-C', 'Full Frame', 'Medium Format'],",
              "    'Teclado': ['60%', '65%', '75%', 'TKL', 'Full Size', 'Compact'],",
              "    'Mouse': ['Standard', 'Mini', 'Large', 'XL'],",
              "    'Parlante': ['Mini', 'Compact', 'Standard', 'Large', 'XL']",
              "};",
              "",
              "// Función para obtener elemento aleatorio",
              "function randomChoice(array) {",
              "    return array[Math.floor(Math.random() * array.length)];",
              "}",
              "",
              "// Función para generar número aleatorio en rango",
              "function randomFloat(min, max, decimals = 2) {",
              "    const value = Math.random() * (max - min) + min;",
              "    return parseFloat(value.toFixed(decimals));",
              "}",
              "",
              "function randomInt(min, max) {",
              "    return Math.floor(Math.random() * (max - min + 1)) + min;",
              "}",
              "",
              "// Generar producto aleatorio",
              "const categoria = randomChoice(categorias);",
              "const marca = randomChoice(marcas);",
              "const adjective = randomChoice(categoria.adjectives);",
              "const modelo = `${marca} ${categoria.tipo} ${adjective}`;",
              "",
              "// Generar especificaciones según la categoría",
              "let peso, dimensiones, precio_base;",
              "",
              "switch(categoria.tipo) {",
              "    case 'Smartphone':",
              "        peso = randomFloat(0.15, 0.25);",
              "        dimensiones = `${randomFloat(14, 17)} x ${randomFloat(7, 8)} x ${randomFloat(0.7, 1)} cm`;",
              "        precio_base = randomFloat(200, 1500);",
              "        break;",
              "    case 'Laptop':",
              "        peso = randomFloat(1.2, 2.8);",
              "        dimensiones = `${randomFloat(30, 40)} x ${randomFloat(20, 28)} x ${randomFloat(1.2, 2.5)} cm`;",
              "        precio_base = randomFloat(500, 3000);",
              "        break;",
              "    case 'Tablet':",
              "        peso = randomFloat(0.3, 0.8);",
              "        dimensiones = `${randomFloat(20, 28)} x ${randomFloat(15, 21)} x ${randomFloat(0.5, 1)} cm`;",
              "        precio_base = randomFloat(150, 1200);",
              "        break;",
              "    case 'Smartwatch':",
              "        peso = randomFloat(0.03, 0.08);",
              "        dimensiones = `${randomFloat(4, 5)} x ${randomFloat(4, 5)} x ${randomFloat(1, 1.5)} cm`;",
              "        precio_base = randomFloat(100, 800);",
              "        break;",
              "    case 'Auriculares':",
              "        peso = randomFloat(0.05, 0.4);",
              "        dimensiones = `${randomFloat(15, 25)} x ${randomFloat(12, 20)} x ${randomFloat(3, 8)} cm`;",
              "        precio_base = randomFloat(50, 500);",
              "        break;",
              "    case 'Cámara':",
              "        peso = randomFloat(0.4, 1.5);",
              "        dimensiones = `${randomFloat(12, 18)} x ${randomFloat(8, 12)} x ${randomFloat(6, 10)} cm`;",
              "        precio_base = randomFloat(300, 2500);",
              "        break;",
              "    case 'Monitor':",
              "        peso = randomFloat(3, 8);",
              "        dimensiones = `${randomFloat(50, 80)} x ${randomFloat(35, 50)} x ${randomFloat(15, 25)} cm`;",
              "        precio_base = randomFloat(200, 1500);",
              "        break;",
              "    case 'Teclado':",
              "        peso = randomFloat(0.5, 1.2);",
              "        dimensiones = `${randomFloat(35, 45)} x ${randomFloat(12, 18)} x ${randomFloat(2, 4)} cm`;",
              "        precio_base = randomFloat(30, 300);",
              "        break;",
              "    case 'Mouse':",
              "        peso = randomFloat(0.08, 0.15);",
              "        dimensiones = `${randomFloat(10, 13)} x ${randomFloat(6, 8)} x ${randomFloat(3, 5)} cm`;",
              "        precio_base = randomFloat(20, 150);",
              "        break;",
              "    case 'Parlante':",
              "        peso = randomFloat(0.3, 2);",
              "        dimensiones = `${randomFloat(15, 30)} x ${randomFloat(10, 20)} x ${randomFloat(8, 15)} cm`;",
              "        precio_base = randomFloat(50, 400);",
              "        break;",
              "    default:",
              "        peso = randomFloat(0.1, 1);",
              "        dimensiones = `${randomFloat(10, 20)} x ${randomFloat(8, 15)} x ${randomFloat(2, 5)} cm`;",
              "        precio_base = randomFloat(50, 500);",
              "}",
              "",
              "// Calcular precios",
              "const precio_costo = randomFloat(precio_base * 0.6, precio_base * 0.8);",
              "const precio_venta = randomFloat(precio_base * 0.9, precio_base * 1.4);",
              "",
              "// Generar descripción detallada",
              "const caracteristicas = [",
              "    'Alta calidad', 'Diseño premium', 'Tecnología avanzada', 'Rendimiento superior',",
              "    'Batería de larga duración', 'Resistente al agua', 'Conectividad 5G',",
              "    'Pantalla OLED', 'Procesador de última generación', 'Cámara profesional',",
              "    'Audio de alta fidelidad', 'Diseño ergonómico', 'Construcción robusta'",
              "];",
              "",
              "const descripcion = `${modelo} con ${randomChoice(caracteristicas).toLowerCase()}. ${randomChoice(caracteristicas)} y ${randomChoice(caracteristicas).toLowerCase()}. Ideal para uso ${randomChoice(['profesional', 'personal', 'gaming', 'empresarial', 'educativo'])}.`;",
              "",
              "// Establecer variables para el request",
              "pm.collectionVariables.set('producto_nombre', modelo);",
              "pm.collectionVariables.set('producto_descripcion', descripcion);",
              "pm.collectionVariables.set('producto_marca', marca);",
              "pm.collectionVariables.set('producto_precio_costo', precio_costo);",
              "pm.collectionVariables.set('producto_precio_venta', precio_venta);",
              "pm.collectionVariables.set('producto_cantidad_stock', randomInt(5, 100));",
              "pm.collectionVariables.set('producto_peso', peso);",
              "pm.collectionVariables.set('producto_dimensiones', dimensiones);",
              "pm.collectionVariables.set('producto_color', randomChoice(colores));",
              "pm.collectionVariables.set('producto_talla', randomChoice(tallas[categoria.tipo] || ['Standard']));",
              "",
              "console.log(`Generando producto: ${modelo}`);",
              "console.log(`Precio: $${precio_venta} (Costo: $${precio_costo})`);",
              "console.log(`Stock: ${pm.collectionVariables.get('producto_cantidad_stock')} unidades`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Verificar que la respuesta sea exitosa",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Verificar estructura de respuesta",
              "pm.test('Response has success field', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "// Verificar que el producto fue creado",
              "pm.test('Product was created successfully', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('producto');",
              "    pm.expect(jsonData.producto).to.have.property('id');",
              "    pm.expect(jsonData.producto.id).to.be.above(0);",
              "});",
              "",
              "// Log del resultado",
              "const jsonData = pm.response.json();",
              "if (jsonData.success) {",
              "    console.log(`✅ Producto creado: ${jsonData.producto.nombre} (ID: ${jsonData.producto.id})`);",
              "} else {",
              "    console.log(`❌ Error: ${jsonData.error}`);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{producto_nombre}}\",\n  \"descripcion\": \"{{producto_descripcion}}\",\n  \"marca\": \"{{producto_marca}}\",\n  \"precio_costo\": {{producto_precio_costo}},\n  \"precio_venta\": {{producto_precio_venta}},\n  \"cantidad_stock\": {{producto_cantidad_stock}},\n  \"peso\": {{producto_peso}},\n  \"dimensiones\": \"{{producto_dimensiones}}\",\n  \"color\": \"{{producto_color}}\",\n  \"talla\": \"{{producto_talla}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/inventario/productos/crear/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "inventario",
            "productos",
            "crear",
            ""
          ]
        }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Configurar URL base si no existe",
          "if (!pm.collectionVariables.get('base_url')) {",
          "    pm.collectionVariables.set('base_url', 'http://127.0.0.1:8000');",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          ""
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "producto_nombre",
      "value": ""
    },
    {
