# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO PARA AUTH0
# ============================================================================
#
# Estas variables deben configurarse en el servidor de producción:
#
# 1. En EC2, agregar al archivo ~/.bashrc o /etc/environment:
#    export AUTH0_DOMAIN="tu-tenant.auth0.com"
#    export AUTH0_AUDIENCE="https://api.provesi-wms.com/inventario"
#    export AUTH0_CLIENT_ID="tu-client-id"
#    export AUTH0_CLIENT_SECRET="tu-client-secret"
#
# 2. En desarrollo local, crear archivo .env:

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.provesi-wms.com/inventario
AUTH0_CLIENT_ID=your-client-id-here
AUTH0_CLIENT_SECRET=your-client-secret-here

# Django Configuration
SECRET_KEY=your-django-secret-key
DEBUG=False

# Database Configuration (ya existente)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# HTTPS Configuration (producción)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True