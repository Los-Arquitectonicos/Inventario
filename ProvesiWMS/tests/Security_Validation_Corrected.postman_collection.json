    {
      "name": "🚨 Critical Security Tests - No Authentication",
      "description": "Verificar que TODOS los endpoints rechazan acceso sin autenticación",
      "item": [
        {
          "name": "Test Productos - No Auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inventario/api/productos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "productos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 CRITICAL: Productos endpoint rejects no auth', function () {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "",
                  "pm.test('🔒 CRITICAL: Error message mentions token', function () {",
                  "    try {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response.error.toLowerCase()).to.include('token');",
                  "    } catch(e) {",
                  "        pm.expect.fail('Response should be JSON with error field');",
                  "    }",
                  "});",
                  "",
                  "if (pm.response.code !== 401) {",
                  "    console.log('🚨 SECURITY VULNERABILITY: Products accessible without auth!');",
                  "    console.log('Response:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
