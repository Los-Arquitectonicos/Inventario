    {
      "name": "🔧 Setup & Authentication",
      "description": "Obtener tokens válidos para cada rol y configurar variables",
      "item": [
        {
          "name": "Get Admin Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login successful', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.globals.set('admin_token', response.access);",
                  "    console.log('✅ Admin token saved');",
                  "} else {",
                  "    console.log('❌ Admin login failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ]
