    {
      "name": "Test 6: Ataques de Fuerza Bruta",
      "description": "Múltiples intentos de acceso rápidos",
      "item": [
        {
          "name": "Múltiples Intentos de Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{$randomPassword}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login fallido con password aleatorio', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
                  "});",
                  "",
                  "pm.test('Rate limiting aplicado (opcional)', function () {",
                  "    // Verificar si hay rate limiting después de múltiples intentos",
                  "    if (pm.response.code === 429) {",
                  "        console.log('Rate limiting detectado - Buena seguridad');",
                  "    }",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Test 7: Resumen de Seguridad",
      "description": "Validación final de todas las pruebas de seguridad",
      "item": [
        {
          "name": "Verificación de Headers de Seguridad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inventario/",
              "host": ["{{base_url}}"],
              "path": ["inventario", ""]
