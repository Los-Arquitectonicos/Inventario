              },
              {
                "key": "X-API-Key",
                "value": "secret_api_key"
              },
              {
                "key": "Cookie",
                "value": "sessionid=admin_session_123456"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"estado\": \"completado\",\n  \"total\": 999999\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Headers alternativos rechazados', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
