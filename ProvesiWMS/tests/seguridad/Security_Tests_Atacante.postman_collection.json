          "name": "Basic Auth en lugar de JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Basic YWRtaW46YWRtaW4="
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"estado\": \"completado\",\n  \"total\": 5000000\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Basic Auth rechazado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
