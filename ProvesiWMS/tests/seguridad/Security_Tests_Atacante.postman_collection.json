                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token JWT Malformado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.MALFORMED.TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"fecha_entrega\": \"2025-12-01\",\n  \"estado\": \"pendiente\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token malformado rechazado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token con Inyección SQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer '; DROP TABLE pedidos; --"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"1'; DROP TABLE clientes; --\",\n  \"estado\": \"../../../etc/passwd\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Intento de inyección SQL bloqueado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 400]);",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Test 3: Bypass de Autenticación",
