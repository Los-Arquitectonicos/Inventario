                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Parámetros GET con Auth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"estado\": \"completado\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/?token=fake_token&auth=admin&user=administrator",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""],
              "query": [
                {
                  "key": "token",
                  "value": "fake_token"
                },
                {
                  "key": "auth",
                  "value": "admin"
                },
                {
                  "key": "user",
                  "value": "administrator"
                }
              ]
