{
  "info": {
    "name": "Security Tests - Atacante Sin Credenciales",
    "description": "Pruebas de seguridad simulando un atacante que intenta modificar información de pedidos sin credenciales válidas. Objetivo: Verificar que el atacante NO pueda modificar información el 100% de las veces.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "security-tests-atacante-001"
  },
  "item": [
    {
      "name": "Configuración de Variables",
      "description": "Variables globales para las pruebas de seguridad",
      "item": [
        {
          "name": "Set Environment Variables",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inventario/",
              "host": ["{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Configurar variables de entorno",
                  "pm.globals.set('base_url', 'https://provesi-alb-2003818714.us-east-1.elb.amazonaws.com');",
                  "pm.globals.set('test_timestamp', new Date().toISOString());",
                  "pm.globals.set('attack_attempts', 0);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Test 1: Acceso Sin Autenticación",
      "description": "Intentar crear pedidos sin ningún token de autenticación",
      "item": [
        {
          "name": "Crear Pedido Sin Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"fecha_entrega\": \"2025-12-01\",\n  \"estado\": \"pendiente\",\n  \"productos\": [\n    {\n      \"producto_id\": 1,\n      \"cantidad\": 5,\n      \"precio_unitario\": 1000000\n    }\n  ],\n  \"total\": 5000000\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Acceso denegado sin token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene mensaje de error apropiado', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('error');",
                  "    pm.expect(response.error.toLowerCase()).to.include('token');",
                  "});",
                  "",
                  "pm.test('No revela información sensible', function () {",
                  "    const responseText = pm.response.text();",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('password');",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('secret');",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('database');",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('traceback');",
                  "});",
                  "",
                  "// Incrementar contador de intentos fallidos",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar Pedido Existente Sin Token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"completado\",\n  \"total\": 999999999,\n  \"fecha_entrega\": \"2025-01-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/1/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "1", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Modificación de pedido denegada sin token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 404, 405]);",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar Pedido Sin Token",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/1/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "1", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Eliminación de pedido denegada sin token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 405]);",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Test 2: Tokens Falsos/Inválidos",
      "description": "Intentar usar tokens JWT falsos, malformados o expirados",
      "item": [
        {
          "name": "Token Completamente Falso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer token_falso_123456789_atacante"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"fecha_entrega\": \"2025-12-01\",\n  \"estado\": \"completado\",\n  \"total\": 999999\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token falso rechazado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "pm.test('Mensaje de error apropiado para token inválido', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.error.toLowerCase()).to.include('inválido');",
                  "});",
