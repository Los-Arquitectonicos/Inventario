    {
      "name": "Test 4: Ataques de Inyección",
      "description": "Intentar inyecciones SQL, XSS y otros ataques en los datos",
      "item": [
        {
          "name": "Inyección SQL en campos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"1; DROP TABLE pedidos; --\",\n  \"estado\": \"' OR '1'='1\",\n  \"fecha_entrega\": \"2025-01-01'; DELETE FROM usuarios; --\",\n  \"total\": \"0; UPDATE productos SET precio = 0; --\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Inyección SQL bloqueada', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
                  "});",
                  "",
                  "pm.test('No ejecuta comandos SQL maliciosos', function () {",
                  "    const responseText = pm.response.text();",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('syntax error');",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('sql');",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cross-Site Scripting (XSS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"<script>alert('XSS')</script>\",\n  \"estado\": \"<img src=x onerror=alert('XSS')>\",\n  \"fecha_entrega\": \"javascript:alert('XSS')\",\n  \"observaciones\": \"<iframe src='javascript:alert(\\\"XSS\\\")'></iframe>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('XSS bloqueado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
                  "});",
                  "",
                  "pm.test('Scripts no ejecutados', function () {",
                  "    const responseText = pm.response.text();",
                  "    pm.expect(responseText).to.not.include('<script>');",
                  "    pm.expect(responseText).to.not.include('javascript:');",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        },
        {
          "name": "Path Traversal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"estado\": \"../../../etc/passwd\",\n  \"fecha_entrega\": \"..\\\\..\\\\..\\\\windows\\\\system32\\\\config\\\\sam\",\n  \"observaciones\": \"/proc/self/environ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Path traversal bloqueado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
                  "});",
                  "",
                  "pm.test('No accede a archivos del sistema', function () {",
                  "    const responseText = pm.response.text();",
                  "    pm.expect(responseText).to.not.include('root:');",
                  "    pm.expect(responseText).to.not.include('etc/passwd');",
                  "});",
                  "",
                  "let attempts = pm.globals.get('attack_attempts') || 0;",
                  "pm.globals.set('attack_attempts', attempts + 1);"
                ]
              }
            }
          ]
        }
      ]
    },
