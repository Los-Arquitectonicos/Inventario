{
  "info": {
    "name": "Anti-Modificacion Pedidos - API Endpoints",
    "description": "Suite que CREA pedidos de prueba y luego INTENTA MODIFICARLOS via API REST. Verifica que atacantes NO puedan usar endpoints JSON para modificar informacion de pedidos existentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "anti-modificacion-api-pedidos-001"
  },
  "item": [
    {
      "name": "SETUP API - Preparar Datos",
      "description": "Configuracion para probar endpoints API de pedidos",
      "item": [
        {
          "name": "Login Admin para API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type", 
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API Setup: Login exitoso', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.globals.set('api_admin_token', response.access);",
                  "    console.log('Token API admin guardado');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "CREAR Pedido Original de Prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"fecha_entrega\": \"2025-12-31\",\n  \"estado\": \"pendiente\",\n  \"total\": 1000.00,\n  \"observaciones\": \"PEDIDO ORIGINAL PARA PRUEBAS DE MODIFICACION - NO MODIFICAR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup: Pedido original creado exitosamente', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    try {",
                  "        const response = pm.response.json();",
                  "        if (response.id) {",
                  "            pm.globals.set('pedido_original_id', response.id);",
                  "            console.log('PEDIDO ORIGINAL CREADO - ID:', response.id);",
                  "            console.log('Total original: $1000.00');",
                  "            console.log('Estado original: pendiente');",
                  "        }",
                  "    } catch (e) {",
                  "        console.log('Error parseando respuesta de creacion');",
                  "    }",
                  "} else {",
                  "    console.log('ERROR: No se pudo crear pedido original para pruebas');",
                  "    pm.globals.set('pedido_original_id', '999');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Pedido Original Creado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup: Pedido original existe y es verificable', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const pedido = pm.response.json();",
                  "    console.log('PEDIDO ORIGINAL VERIFICADO:');",
                  "    console.log('   ID:', pedido.id);",
                  "    console.log('   Total:', pedido.total);",
                  "    console.log('   Estado:', pedido.estado);",
                  "    console.log('   Observaciones:', pedido.observaciones);",
                  "    console.log('');",
                  "    console.log('LISTO PARA INTENTOS DE MODIFICACION...');",
                  "} else {",
                  "    console.log('ERROR: No se puede verificar pedido original');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ATAQUES DE MODIFICACION - Sin Autenticacion",
      "description": "Intentos de modificar el pedido original SIN TOKEN - DEBEN FALLAR 100%",
      "item": [
        {
          "name": "Atacante: PUT Modificar Pedido SIN TOKEN",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 999,\n  \"fecha_entrega\": \"2030-01-01\",\n  \"estado\": \"completado\",\n  \"total\": 999999999.99,\n  \"observaciones\": \"PEDIDO MODIFICADO POR ATACANTE - FRAUDE DETECTADO - TOTAL ALTERADO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MODIFICACION CRITICA: PUT sin token BLOQUEADO', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 405]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('🚨 VULNERABILIDAD GRAVISIMA DETECTADA! 🚨');",
                  "    console.log('Atacante MODIFICO PEDIDO sin autenticacion');",
                  "    console.log('Total cambiado de $1000 a $999,999,999.99');",
                  "    console.log('Estado cambiado de \"pendiente\" a \"completado\"');",
                  "    pm.globals.set('modificacion_exitosa', 'true');",
                  "} else {",
                  "    console.log('✅ PUT bloqueado - Pedido protegido contra modificacion');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Atacante: PATCH Modificar Total SIN TOKEN",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total\": 0.01,\n  \"observaciones\": \"TOTAL MODIFICADO POR ATACANTE - PEDIDO CASI GRATIS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MODIFICACION CRITICA: PATCH sin token BLOQUEADO', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 405]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('🚨 VULNERABILIDAD FINANCIERA DETECTADA! 🚨');",
                  "    console.log('Atacante MODIFICO TOTAL de pedido sin autenticacion');",
                  "    console.log('Total reducido de $1000.00 a $0.01');",
                  "    pm.globals.set('modificacion_exitosa', 'true');",
                  "} else {",
                  "    console.log('✅ PATCH bloqueado - Total protegido');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Atacante: DELETE Eliminar Pedido SIN TOKEN",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ELIMINACION CRITICA: DELETE sin token BLOQUEADO', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 405]);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 204) {",
                  "    console.log('🚨 VULNERABILIDAD DE ELIMINACION DETECTADA! 🚨');",
                  "    console.log('Atacante ELIMINO PEDIDO sin autenticacion');",
                  "    console.log('Pedido ID', pm.globals.get('pedido_original_id'), 'ELIMINADO');",
                  "    pm.globals.set('eliminacion_exitosa', 'true');",
                  "} else {",
                  "    console.log('✅ DELETE bloqueado - Pedido protegido contra eliminacion');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ATAQUES DE MODIFICACION - Con Token Robado",
      "description": "Intentos de modificar el pedido usando token de admin - Evalua permisos API",
      "item": [
        {
          "name": "Atacante: PUT Modificar con Token Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 666,\n  \"fecha_entrega\": \"2099-12-31\",\n  \"estado\": \"completado\",\n  \"total\": 888888888.88,\n  \"observaciones\": \"PEDIDO MODIFICADO POR ATACANTE CON TOKEN ROBADO - FRAUDE CON AUTENTICACION\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MODIFICACION CON TOKEN: PUT debe ser evaluado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 403, 405]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('⚠️  MODIFICACION CON TOKEN EXITOSA');",
                  "    console.log('   Token admin permite modificar pedidos');",
                  "    console.log('   Total cambiado a $888,888,888.88');",
                  "    console.log('   Estado cambiado a \"completado\"');",
                  "    pm.globals.set('modificacion_con_token', 'true');",
                  "} else if (pm.response.code === 403) {",
                  "    console.log('✅ PUT con token RECHAZADO - Permisos correctos');",
                  "} else {",
                  "    console.log('✅ PUT no soportado - Endpoint protegido');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Atacante: PATCH Estado con Token Admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"cancelado\",\n  \"observaciones\": \"PEDIDO CANCELADO POR ATACANTE CON TOKEN ADMIN ROBADO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MODIFICACION CON TOKEN: PATCH debe ser evaluado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 403, 405]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('⚠️  PATCH CON TOKEN EXITOSO');",
                  "    console.log('   Token admin permite cambiar estado');",
                  "    console.log('   Estado cambiado a \"cancelado\"');",
                  "    pm.globals.set('modificacion_con_token', 'true');",
                  "} else if (pm.response.code === 403) {",
                  "    console.log('✅ PATCH con token RECHAZADO - Permisos correctos');",
                  "} else {",
                  "    console.log('✅ PATCH no soportado - Endpoint protegido');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "VERIFICACION POST-ATAQUE",
      "description": "Verifica el estado del pedido despues de intentos de modificacion",
      "item": [
        {
          "name": "Verificar Pedido Despues de Ataques",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/{{pedido_original_id}}/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", "{{pedido_original_id}}", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST-ATAQUE: Pedido verificable', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const pedido = pm.response.json();",
                  "    console.log('');",
                  "    console.log('ESTADO FINAL DEL PEDIDO:');",
                  "    console.log('   ID:', pedido.id);",
                  "    console.log('   Total:', pedido.total);",
                  "    console.log('   Estado:', pedido.estado);",
                  "    console.log('   Observaciones:', pedido.observaciones);",
                  "    ",
                  "    // Verificar si el pedido fue modificado",
                  "    if (pedido.total === 1000.00 && pedido.estado === 'pendiente') {",
                  "        console.log('');",
                  "        console.log('✅ PEDIDO INTACTO - No modificado por ataques');",
                  "        pm.globals.set('pedido_intacto', 'true');",
                  "    } else {",
                  "        console.log('');",
                  "        console.log('🚨 PEDIDO MODIFICADO - Ataques exitosos');",
                  "        console.log('   Total original: $1000.00');",
                  "        console.log('   Estado original: pendiente');",
                  "        pm.globals.set('pedido_intacto', 'false');",
                  "    }",
                  "} else if (pm.response.code === 404) {",
                  "    console.log('🚨 PEDIDO ELIMINADO - DELETE exitoso');",
                  "    pm.globals.set('pedido_eliminado', 'true');",
                  "} else {",
                  "    console.log('Error verificando estado del pedido');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "REPORTE FINAL DE MODIFICACION",
      "description": "Reporte completo de intentos de modificacion de pedidos",
      "item": [
        {
          "name": "REPORTE FINAL - ANTI MODIFICACION",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inventario/",
              "host": ["{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('');",
                  "console.log('==========================================');",
                  "console.log('REPORTE FINAL - ANTI MODIFICACION PEDIDOS');",
                  "console.log('==========================================');",
                  "console.log('');",
                  "",
                  "const pedidoIntacto = pm.globals.get('pedido_intacto');",
                  "const pedidoEliminado = pm.globals.get('pedido_eliminado');",
                  "const modificacionSinToken = pm.globals.get('modificacion_exitosa');",
                  "const modificacionConToken = pm.globals.get('modificacion_con_token');",
                  "",
                  "console.log('RESUMEN DE ATAQUES DE MODIFICACION:');",
                  "console.log('');",
                  "",
                  "console.log('1. ATAQUES SIN AUTENTICACION:');",
                  "console.log('   PUT sin token:', modificacionSinToken === 'true' ? '🚨 EXITOSO' : '✅ BLOQUEADO');",
                  "console.log('   PATCH sin token:', modificacionSinToken === 'true' ? '🚨 EXITOSO' : '✅ BLOQUEADO');",
                  "console.log('   DELETE sin token:', pedidoEliminado === 'true' ? '🚨 EXITOSO' : '✅ BLOQUEADO');",
                  "console.log('');",
                  "",
                  "console.log('2. ATAQUES CON TOKEN ADMIN:');",
                  "console.log('   PUT con token:', modificacionConToken === 'true' ? '⚠️  EXITOSO' : '✅ BLOQUEADO');",
                  "console.log('   PATCH con token:', modificacionConToken === 'true' ? '⚠️  EXITOSO' : '✅ BLOQUEADO');",
                  "console.log('');",
                  "",
                  "console.log('3. ESTADO FINAL DEL PEDIDO ORIGINAL:');",
                  "if (pedidoEliminado === 'true') {",
                  "    console.log('   ELIMINADO por atacante');",
                  "} else if (pedidoIntacto === 'true') {",
                  "    console.log('   INTACTO - Total: $1000.00, Estado: pendiente');",
                  "} else if (pedidoIntacto === 'false') {",
                  "    console.log('   MODIFICADO por atacante');",
                  "} else {",
                  "    console.log('   Estado DESCONOCIDO');",
                  "}",
                  "console.log('');",
                  "",
                  "// Evaluar resultado general",
                  "let resultadoFinal = 'EXITOSO';",
                  "let vulnerabilidadesCriticas = 0;",
                  "",
                  "if (modificacionSinToken === 'true' || pedidoEliminado === 'true') {",
                  "    resultadoFinal = 'FALLO CRITICO';",
                  "    vulnerabilidadesCriticas++;",
                  "    console.log('🚨 FALLO CRITICO: Modificaciones sin autenticacion');",
                  "}",
                  "",
                  "if (modificacionConToken === 'true') {",
                  "    console.log('⚠️  ATENCION: Token admin permite modificaciones');",
                  "    console.log('   (Evaluar si esto es comportamiento esperado)');",
                  "}",
                  "",
                  "if (resultadoFinal === 'EXITOSO') {",
                  "    console.log('✅ PRUEBA EXITOSA: Pedidos protegidos contra modificacion');",
                  "    console.log('   Ningun atacante sin autenticacion puede modificar pedidos');",
                  "}",
                  "",
                  "console.log('');",
                  "console.log('OBJETIVO: Prevenir modificacion no autorizada de pedidos');",
                  "console.log('RESULTADO:', resultadoFinal);",
                  "console.log('==========================================');",
                  "",
                  "pm.test('ANTI-MODIFICACION: Pedidos protegidos', function () {",
                  "    pm.expect(vulnerabilidadesCriticas).to.equal(0);",
                  "});",
                  "",
                  "// Limpiar variables globales",
                  "pm.globals.unset('api_admin_token');",
                  "pm.globals.unset('pedido_original_id');",
                  "pm.globals.unset('modificacion_exitosa');",
                  "pm.globals.unset('eliminacion_exitosa');",
                  "pm.globals.unset('modificacion_con_token');",
                  "pm.globals.unset('pedido_intacto');",
                  "pm.globals.unset('pedido_eliminado');"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
