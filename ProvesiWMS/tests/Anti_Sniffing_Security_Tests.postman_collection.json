{
  "info": {
    "name": "Pruebas Anti-Sniffing - Protección de Datos",
    "description": "Pruebas para validar que la aplicación previene ataques de sniffing mediante HTTPS, headers de seguridad y protección de credenciales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "anti-sniffing-tests-001"
  },
  "item": [
    {
      "name": "🔐 Test 1: Forzar HTTPS",
      "description": "Validar que la aplicación fuerza el uso de HTTPS y rechaza HTTP",
      "item": [
        {
          "name": "Intento de Login via HTTP (Debe Fallar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "http://{{load_balancer_dns}}/inventario/auth/token/",
              "protocol": "http",
              "host": ["{{load_balancer_dns}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 HTTP redirige a HTTPS o es rechazado', function () {",
                  "    // Debe redirigir (301/302) o rechazar (400/403)",
                  "    pm.expect(pm.response.code).to.be.oneOf([301, 302, 400, 403, 404]);",
                  "});",
                  "",
                  "pm.test('🔒 No expone credenciales en HTTP', function () {",
                  "    const response = pm.response.text();",
                  "    // No debe mostrar tokens o información sensible",
                  "    pm.expect(response.toLowerCase()).to.not.include('access_token');",
                  "    pm.expect(response.toLowerCase()).to.not.include('refresh_token');",
                  "    pm.expect(response.toLowerCase()).to.not.include('jwt');",
                  "});",
                  "",
                  "console.log('✅ Intento HTTP bloqueado/redirigido correctamente');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Redirección HTTPS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{load_balancer_dns}}/inventario/",
              "protocol": "http",
              "host": ["{{load_balancer_dns}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 HTTP redirige automáticamente a HTTPS', function () {",
                  "    // 301 = Permanent Redirect, 302 = Temporary Redirect",
                  "    pm.expect(pm.response.code).to.be.oneOf([301, 302]);",
                  "});",
                  "",
                  "pm.test('🔒 Header Location apunta a HTTPS', function () {",
                  "    const location = pm.response.headers.get('Location');",
                  "    if (location) {",
                  "        pm.expect(location).to.include('https://');",
                  "    }",
                  "});",
                  "",
                  "console.log('✅ Redirección HTTPS configurada correctamente');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🛡️ Test 2: Headers de Seguridad Anti-Sniffing",
      "description": "Verificar que están presentes todos los headers de seguridad necesarios",
      "item": [
        {
          "name": "Verificar HSTS (HTTP Strict Transport Security)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{base_url}}/inventario/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 HSTS Header presente', function () {",
                  "    const hsts = pm.response.headers.get('Strict-Transport-Security');",
                  "    pm.expect(hsts).to.exist;",
                  "    console.log('HSTS Header:', hsts);",
                  "});",
                  "",
                  "pm.test('🔒 HSTS incluye max-age', function () {",
                  "    const hsts = pm.response.headers.get('Strict-Transport-Security');",
                  "    if (hsts) {",
                  "        pm.expect(hsts.toLowerCase()).to.include('max-age');",
                  "    }",
                  "});",
                  "",
                  "pm.test('🔒 HSTS incluye includeSubDomains', function () {",
                  "    const hsts = pm.response.headers.get('Strict-Transport-Security');",
                  "    if (hsts) {",
                  "        pm.expect(hsts.toLowerCase()).to.include('includesubdomains');",
                  "    }",
                  "});",
                  "",
                  "console.log('✅ HSTS protege contra ataques de downgrade');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Secure Cookie Settings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "https://{{base_url}}/inventario/auth/token/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Login exitoso via HTTPS', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('🔒 Cookies marcadas como Secure', function () {",
                  "    const setCookies = pm.response.headers.get('Set-Cookie');",
                  "    if (setCookies) {",
                  "        pm.expect(setCookies.toLowerCase()).to.include('secure');",
                  "    }",
                  "});",
                  "",
                  "pm.test('🔒 Cookies marcadas como HttpOnly', function () {",
                  "    const setCookies = pm.response.headers.get('Set-Cookie');",
                  "    if (setCookies) {",
                  "        pm.expect(setCookies.toLowerCase()).to.include('httponly');",
                  "    }",
                  "});",
                  "",
                  "pm.test('🔒 X-Content-Type-Options presente', function () {",
                  "    const xContentType = pm.response.headers.get('X-Content-Type-Options');",
                  "    pm.expect(xContentType).to.exist;",
                  "    pm.expect(xContentType.toLowerCase()).to.include('nosniff');",
                  "});",
                  "",
                  "pm.test('🔒 X-Frame-Options presente', function () {",
                  "    const xFrame = pm.response.headers.get('X-Frame-Options');",
                  "    pm.expect(xFrame).to.exist;",
                  "    pm.expect(xFrame.toLowerCase()).to.be.oneOf(['deny', 'sameorigin']);",
                  "});",
                  "",
                  "// Guardar token para siguiente test",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.access) {",
                  "        pm.globals.set('valid_token', response.access);",
                  "    }",
                  "}",
                  "",
                  "console.log('✅ Headers de seguridad anti-sniffing configurados');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Content Security Policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{base_url}}/inventario/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Content-Security-Policy presente', function () {",
                  "    const csp = pm.response.headers.get('Content-Security-Policy');",
                  "    // CSP es opcional pero recomendado",
                  "    if (csp) {",
                  "        pm.expect(csp).to.exist;",
                  "        console.log('CSP configurado:', csp);",
                  "    } else {",
                  "        console.log('⚠️  CSP no configurado (recomendado para mayor seguridad)');",
                  "    }",
                  "});",
                  "",
                  "pm.test('🔒 Referrer Policy presente', function () {",
                  "    const referrer = pm.response.headers.get('Referrer-Policy');",
                  "    if (referrer) {",
                  "        pm.expect(referrer).to.exist;",
                  "        console.log('Referrer Policy:', referrer);",
                  "    }",
                  "});",
                  "",
                  "console.log('✅ Políticas de contenido verificadas');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔍 Test 3: Detección de Información Sensible",
      "description": "Verificar que no se expone información sensible en las respuestas",
      "item": [
        {
          "name": "Verificar Headers del Servidor",
          "request": {
            "method": "HEAD",
            "header": [],
            "url": {
              "raw": "https://{{base_url}}/inventario/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 No revela versión específica del servidor', function () {",
                  "    const server = pm.response.headers.get('Server');",
                  "    if (server) {",
                  "        // No debe mostrar versiones específicas",
                  "        pm.expect(server.toLowerCase()).to.not.match(/apache\\/2\\.[0-9]+\\.[0-9]+/);",
                  "        pm.expect(server.toLowerCase()).to.not.match(/nginx\\/1\\.[0-9]+\\.[0-9]+/);",
                  "        pm.expect(server.toLowerCase()).to.not.include('django');",
                  "        pm.expect(server.toLowerCase()).to.not.include('python');",
                  "        console.log('Server header (oculto):', server);",
                  "    }",
                  "});",
                  "",
                  "pm.test('🔒 No revela tecnología backend', function () {",
                  "    const xPowered = pm.response.headers.get('X-Powered-By');",
                  "    pm.expect(xPowered).to.not.exist;",
                  "});",
                  "",
                  "console.log('✅ Información del servidor oculta correctamente');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Respuestas de Error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario_inexistente\",\n  \"password\": \"password_falso\"\n}"
            },
            "url": {
              "raw": "https://{{base_url}}/inventario/auth/token/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Error de login no revela información sensible', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "    ",
                  "    const responseText = pm.response.text().toLowerCase();",
                  "    ",
                  "    // No debe revelar información específica",
                  "    pm.expect(responseText).to.not.include('traceback');",
                  "    pm.expect(responseText).to.not.include('exception');",
                  "    pm.expect(responseText).to.not.include('stack trace');",
                  "    pm.expect(responseText).to.not.include('django');",
                  "    pm.expect(responseText).to.not.include('python');",
                  "    pm.expect(responseText).to.not.include('database');",
                  "    pm.expect(responseText).to.not.include('sql');",
                  "    pm.expect(responseText).to.not.include('secret_key');",
                  "    pm.expect(responseText).to.not.include('settings.py');",
                  "});",
                  "",
                  "pm.test('🔒 Mensaje de error genérico', function () {",
                  "    const response = pm.response.json();",
                  "    // Debe ser un mensaje genérico, no específico",
                  "    pm.expect(response.error).to.exist;",
                  "    pm.expect(response.error.toLowerCase()).to.include('inválid');",
                  "});",
                  "",
                  "console.log('✅ Errores no revelan información sensible');"
                ]
              }
            }
          ]
        },
        {
          "name": "Probar Endpoint No Existente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{base_url}}/inventario/api/endpoint-inexistente/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", "api", "endpoint-inexistente", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 404 no revela estructura de la aplicación', function () {",
                  "    pm.expect(pm.response.code).to.equal(404);",
                  "    ",
                  "    const responseText = pm.response.text().toLowerCase();",
                  "    ",
                  "    // No debe mostrar rutas internas o estructura",
                  "    pm.expect(responseText).to.not.include('urls.py');",
                  "    pm.expect(responseText).to.not.include('views.py');",
                  "    pm.expect(responseText).to.not.include('models.py');",
                  "    pm.expect(responseText).to.not.include('/home/');",
                  "    pm.expect(responseText).to.not.include('/var/www/');",
                  "    pm.expect(responseText).to.not.include('django.contrib');",
                  "});",
                  "",
                  "console.log('✅ Páginas 404 no revelan estructura interna');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🕵️ Test 4: Protección de Datos en Tránsito",
      "description": "Verificar que los datos sensibles están protegidos durante la transmisión",
      "item": [
        {
          "name": "Verificar Encriptación de Credenciales",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "https://{{base_url}}/inventario/auth/token/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Login exitoso con HTTPS', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('🔒 Conexión usa TLS/SSL', function () {",
                  "    // Si estamos aquí, la conexión HTTPS funcionó",
                  "    pm.expect(pm.request.url.toString()).to.include('https://');",
                  "});",
                  "",
                  "pm.test('🔒 Token JWT retornado de forma segura', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.access).to.exist;",
                  "    pm.expect(response.access).to.be.a('string');",
                  "    pm.expect(response.access.length).to.be.greaterThan(100); // JWT es largo",
                  "    ",
                  "    // Guardar token para próximas pruebas",
                  "    pm.globals.set('secure_token', response.access);",
                  "});",
                  "",
                  "console.log('✅ Datos transmitidos de forma segura via HTTPS');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Protección de Tokens en Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{secure_token}}"
              }
            ],
            "url": {
              "raw": "https://{{base_url}}/inventario/api/productos/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", "api", "productos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Token JWT funciona via HTTPS', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('🔒 Datos retornados de forma segura', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('🔒 Token no aparece en logs o respuestas', function () {",
                  "    const responseText = pm.response.text();",
                  "    const token = pm.globals.get('secure_token');",
                  "    ",
                  "    // El token no debe aparecer en la respuesta",
                  "    pm.expect(responseText).to.not.include(token);",
                  "});",
                  "",
                  "console.log('✅ Tokens protegidos durante transmisión');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🚫 Test 5: Prevención de Man-in-the-Middle",
      "description": "Verificar protecciones contra ataques MITM",
      "item": [
        {
          "name": "Verificar Certificate Pinning",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{base_url}}/inventario/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Conexión HTTPS establecida', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "",
                  "pm.test('🔒 Public Key Pinning headers', function () {",
                  "    const pkp = pm.response.headers.get('Public-Key-Pins');",
                  "    if (pkp) {",
                  "        pm.expect(pkp).to.exist;",
                  "        console.log('Public Key Pinning configurado:', pkp);",
                  "    } else {",
                  "        console.log('⚠️  Public Key Pinning no configurado (opcional)');",
                  "    }",
                  "});",
                  "",
                  "pm.test('🔒 HSTS previene downgrades', function () {",
                  "    const hsts = pm.response.headers.get('Strict-Transport-Security');",
                  "    pm.expect(hsts).to.exist;",
                  "    pm.expect(hsts).to.include('max-age');",
                  "});",
                  "",
                  "console.log('✅ Protecciones MITM verificadas');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Integridad de Respuestas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "https://{{base_url}}/inventario/auth/token/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 Response intacta via HTTPS', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('access');",
                  "    pm.expect(response).to.have.property('refresh');",
                  "});",
                  "",
                  "pm.test('🔒 JWT tokens válidos y no modificados', function () {",
                  "    const response = pm.response.json();",
                  "    const accessToken = response.access;",
                  "    ",
                  "    // JWT debe tener 3 partes separadas por puntos",
                  "    const parts = accessToken.split('.');",
                  "    pm.expect(parts).to.have.lengthOf(3);",
                  "    ",
                  "    // Cada parte debe ser base64",
                  "    parts.forEach((part, index) => {",
                  "        pm.expect(part).to.match(/^[A-Za-z0-9_-]+$/);",
                  "    });",
                  "});",
                  "",
                  "console.log('✅ Integridad de datos verificada');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "📊 Test 6: Resumen Anti-Sniffing",
      "description": "Resumen final de todas las protecciones contra sniffing",
      "item": [
        {
          "name": "Reporte Final de Seguridad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{base_url}}/inventario/",
              "host": ["https://{{base_url}}"],
              "path": ["inventario", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('📊 RESUMEN: Protecciones Anti-Sniffing Completas', function () {",
