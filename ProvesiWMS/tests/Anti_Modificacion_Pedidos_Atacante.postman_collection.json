    {
      "name": "🚨 ATAQUE 1 - Sin Autenticación",
      "description": "Intentos de modificación SIN token de autenticación - DEBEN FALLAR 100%",
      "item": [
        {
          "name": "Atacante: Modificar Pedido #1 SIN TOKEN",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"cancelado\",\n  \"total\": 999999999,\n  \"observaciones\": \"ATACANTE MODIFICÓ ESTE PEDIDO - SISTEMA COMPROMETIDO!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/pedidos/{{pedido_test_1}}/actualizar-estado/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "pedidos", "{{pedido_test_1}}", "actualizar-estado", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('🔒 CRÍTICO: Atacante SIN TOKEN no puede modificar pedido', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 302]);",
                  "});",
                  "",
                  "pm.test('🔒 CRÍTICO: Sistema rechaza modificación sin autenticación', function () {",
                  "    // Cualquier código que NO sea 200 o 201 es correcto",
                  "    pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// Verificación crítica",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    console.log('🚨🚨🚨 VULNERABILIDAD CRÍTICA DETECTADA! 🚨🚨🚨');",
                  "    console.log('El atacante SIN CREDENCIALES pudo modificar el pedido');",
                  "    console.log('SISTEMA COMPROMETIDO - FALLO EN REQUISITO DE SEGURIDAD');",
                  "    console.log('Respuesta:', pm.response.text());",
                  "    ",
                  "    // Marcar como fallo crítico",
                  "    pm.globals.set('critical_vulnerability_found', 'true');",
                  "} else {",
                  "    console.log('✅ SEGURIDAD: Atacante sin token correctamente bloqueado');",
                  "    console.log('Código de respuesta:', pm.response.code);",
                  "}"
                ]
              }
            }
          ]
        },
