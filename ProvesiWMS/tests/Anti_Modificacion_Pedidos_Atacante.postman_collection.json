{
  "info": {
    "name": "Validación Anti-Modificación de Pedidos - Atacante",
    "description": "Suite de pruebas específica para validar que un atacante SIN credenciales válidas NO PUEDE modificar información de pedidos. Cumple con el requerimiento: 'el atacante no pueda modificar la información y esto debe suceder el 100%'",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "anti-modificacion-pedidos-001"
  },
  "item": [
    {
      "name": "🔧 SETUP - Crear Pedidos de Prueba",
      "description": "Configuración inicial: crear pedidos válidos que el atacante intentará modificar",
      "item": [
        {
          "name": "Login Admin (Setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Setup: Admin login exitoso', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.globals.set('admin_token', response.access);",
                  "    console.log('✅ Setup completado: Token admin guardado');",
                  "} else {",
                  "    console.log('❌ Setup falló: No se pudo obtener token admin');",
                  "    pm.globals.set('setup_failed', 'true');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear Pedido Test #1 (Setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"fecha_entrega\": \"2025-12-15\",\n  \"estado\": \"pendiente\",\n  \"total\": 150000,\n  \"observaciones\": \"Pedido crítico para pruebas de seguridad - NO MODIFICAR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.globals.get('setup_failed')) {",
                  "    console.log('⚠️ Saltando creación de pedido - setup falló');",
                  "    return;",
                  "}",
                  "",
                  "pm.test('✅ Setup: Pedido test #1 creado', function () {",
                  "    // Puede ser 201 (creado) o 404 (endpoint no implementado)",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    try {",
                  "        const response = pm.response.json();",
                  "        if (response.pedido && response.pedido.id) {",
                  "            pm.globals.set('pedido_test_1', response.pedido.id);",
                  "            console.log('✅ Pedido Test #1 creado con ID:', response.pedido.id);",
                  "        } else if (response.id) {",
                  "            pm.globals.set('pedido_test_1', response.id);",
                  "            console.log('✅ Pedido Test #1 creado con ID:', response.id);",
                  "        } else {",
                  "            pm.globals.set('pedido_test_1', '1'); // ID por defecto",
                  "            console.log('✅ Pedido creado, usando ID por defecto: 1');",
                  "        }",
                  "    } catch (e) {",
                  "        pm.globals.set('pedido_test_1', '1');",
                  "        console.log('✅ Respuesta no JSON, usando ID por defecto: 1');",
                  "    }",
                  "} else if (pm.response.code === 404) {",
                  "    pm.globals.set('pedido_test_1', '1'); // ID existente para probar",
                  "    console.log('⚠️ Endpoint POST pedidos no disponible, usando ID existente: 1');",
                  "} else {",
                  "    console.log('❌ Error creando pedido test:', pm.response.text());",
                  "    pm.globals.set('pedido_test_1', '1');",
                  "}"
                ]
              }
            }
          ]
        },
