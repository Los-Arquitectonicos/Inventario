{
  "info": {
    "name": "Anti-Modificación Pedidos - API Endpoints",
    "description": "Suite complementaria que valida específicamente los endpoints de API REST para pedidos. Verifica que atacantes NO puedan usar endpoints JSON para modificar información de pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "anti-modificacion-api-pedidos-001"
  },
  "item": [
    {
      "name": "🔧 SETUP API - Preparar Datos",
      "description": "Configuración para probar endpoints API de pedidos",
      "item": [
        {
          "name": "Login Admin para API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type", 
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProvesiAdmin2024!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inventario/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["inventario", "auth", "token", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ API Setup: Login exitoso', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.globals.set('api_admin_token', response.access);",
                  "    console.log('✅ Token API admin guardado');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar Endpoint API Pedidos Existe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/inventario/api/pedidos/?limit=1",
              "host": ["{{base_url}}"],
              "path": ["inventario", "api", "pedidos", ""],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ API Setup: Endpoint pedidos verificado', function () {",
                  "    // 200 (existe), 404 (no existe), 401/403 (problemas auth)",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 401, 403]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('✅ API Endpoint /api/pedidos/ EXISTE y responde');",
                  "    pm.globals.set('api_endpoint_exists', 'true');",
                  "    ",
                  "    // Intentar obtener ID de pedido existente",
                  "    try {",
                  "        const response = pm.response.json();",
                  "        if (response.pedidos && response.pedidos.length > 0) {",
                  "            pm.globals.set('existing_pedido_id', response.pedidos[0].id);",
                  "            console.log('✅ ID de pedido existente encontrado:', response.pedidos[0].id);",
                  "        } else {",
                  "            pm.globals.set('existing_pedido_id', '1'); // ID por defecto",
                  "        }",
                  "    } catch (e) {",
                  "        pm.globals.set('existing_pedido_id', '1');",
                  "    }",
                  "} else if (pm.response.code === 404) {",
                  "    console.log('⚠️ API Endpoint /api/pedidos/ NO EXISTE - pruebas limitadas');",
                  "    pm.globals.set('api_endpoint_exists', 'false');",
                  "    pm.globals.set('existing_pedido_id', '1');",
                  "} else {",
                  "    console.log('⚠️ Problema con endpoint API - código:', pm.response.code);",
                  "    pm.globals.set('api_endpoint_exists', 'unknown');",
                  "    pm.globals.set('existing_pedido_id', '1');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
