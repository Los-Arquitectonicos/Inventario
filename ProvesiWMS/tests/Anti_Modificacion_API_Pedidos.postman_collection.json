                  "    pm.test('🔒 API: Error de token inválido correcto', function () {",
                  "        try {",
                  "            const response = pm.response.json();",
                  "            const hasTokenError = response.error && (",
                  "                response.error.toLowerCase().includes('token') ||",
                  "                response.error.toLowerCase().includes('invalid') ||",
                  "                response.code === 'INVALID_TOKEN'",
                  "            );",
                  "            pm.expect(hasTokenError).to.be.true;",
                  "        } catch(e) {",
                  "            // Si no es JSON, pero es 401, está bien",
                  "            pm.expect(true).to.be.true;",
                  "        }",
                  "    });",
                  "}",
                  "",
                  "if (pm.response.code === 200) {",
